DATABASE_URL="postgresql://qflow:qflow_dev_pass@localhost:5432/qflow?schema=public"
DIRECT_URL="postgresql://qflow:qflow_dev_pass@localhost:5432/qflow?schema=public"
JWT_SECRET="dev-secret-qflow-integration-change-me"
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:3000"
CLIENT_CHECKIN_URL="http://localhost:3000/customer/join"
PORT=5000

# ---- SMS Notifications (optional but required for real SMS) ----
# SMS is ALWAYS sent to the customer's phone number (no channel preference).
# If not configured, tickets still work and notifications are only logged.
SMS_API_URL="https://api.bms.africa/v1/sms/quick"
SMS_API_KEY=""
SMS_SENDER_ID="QFlow"
