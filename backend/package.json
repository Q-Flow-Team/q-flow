{
  "name": "@qflow/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "vercel-build": "npx prisma generate --schema=../database/prisma/schema.prisma && tsc",
    "generate:swagger": "tsx scripts/generate-swagger.ts",
    "build": "npm run generate:swagger && tsc",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@qflow/database": "file:../database",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}